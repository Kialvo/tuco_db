APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AI_ORCHESTRATION_API_KEY=

AUTH_MAIL_HOST=
AUTH_MAIL_PORT=465
AUTH_MAIL_ENCRYPTION=ssl
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_MAIL_FROM_ADDRESS=

# Team alerts on completed guest registration (email + Discord webhook)
NEW_USER_ALERT_EMAIL=networkmenford@gmail.com
DISCORD_NEW_USER_WEBHOOK_URL=

# Comma-separated emails allowed to use "Bulk Add to Campaign" on /websites
# (admin role is required on top of this). Unset or empty = the config default
# (Martina + Marvin). Set it explicitly to change who has access.
BULK_CAMPAIGN_MANAGERS=
AUTH_MAIL_FROM_NAME=

# Readability audit login (local only — see scripts/README-audit.md). Never commit real values.
AUDIT_EMAIL=
AUDIT_PASSWORD=

# Owner of campaigns opened by marketplace orders (falls back to Martina)
MARKETPLACE_CAMPAIGN_OWNER=

# Timezone shown to people. Storage stays UTC (APP_TIMEZONE); this is display only.
APP_DISPLAY_TIMEZONE=

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Read-only Monday.com token for monday:import-network-sales (Monday > Admin > API)
MONDAY_API_TOKEN=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Which gateway takes the money. Defaults to 'fake' in config/tokens.php so a
# missing value can never put a half-configured live gateway in front of a
# customer. Set to 'stripe' only once the keys below are real.
PAYMENTS_DRIVER=fake

# Does placing an order SPEND tokens? Defaults to false so this can ship
# dormant: with it off, order submission behaves exactly as it always has.
# Switching it on makes the marketplace prepaid — guests with no balance can
# no longer place an order. That is an announced product change, never
# something a deploy should do by itself.
TOKENS_SPENDING_ENABLED=false

# Accounts that spend tokens even while the switch above is OFF. Comma-separated
# emails. This is what makes it possible to test holds and captures on real data
# without blocking a single customer — the switch above is all-or-nothing.
# Only ever ADDS accounts; it cannot exclude anyone once the switch is on.
TOKENS_SPENDING_TEST_USERS=

# Lets the system change publication statuses without a human: expiring a
# publisher who never confirmed (5 working days) and publishing an article the
# client never answered (3 working days, after a reminder). Defaults to false —
# this changes how Martina's queue behaves, so it is a decision, not a deploy.
# `marketplace:advance-overdue --dry-run` works regardless of this setting.
MARKETPLACE_AUTO_ADVANCE=false

# Stripe. Sandbox keys start sk_test_/pk_test_ and CANNOT move money; live keys
# start sk_live_/pk_live_ and can. Never commit either.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. Environment-specific and NOT
# transferable: locally, `stripe listen --print-secret` issues one for the CLI;
# a deployed environment uses the secret from its own Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
